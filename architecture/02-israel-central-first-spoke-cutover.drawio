        <mxCell id="vpn-gcp" value="S2S VPN + BGP" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0078d4;strokeWidth=3;endArrow=none;labelBackgroundColor=#fff;exitX=1;exitY=0.5;entryX=0;entryY=0.77;" edge="1" source="gcp" target="il-gwsub" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="13" as="offset"/></mxGeometry></mxCell>
